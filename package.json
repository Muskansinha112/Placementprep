{
  "name": "placementprep-ai",
  "version": "1.0.0",
  "description": "Full-Stack GenAI Interview Preparation Platform using React, LangChain.js, ChromaDB, MongoDB and Express",
  "type": "module",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "npm run build && node backend/src/server.js",
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch backend/src/server.js",
    "dev:web": "vite --config frontend/vite.config.js --host 0.0.0.0",
    "setup:python": "python3 -m venv ai-service/.venv && ai-service/.venv/bin/python -m pip install -r ai-service/requirements.txt",
    "dev:python": "ai-service/.venv/bin/python -m uvicorn app:app --app-dir ai-service --host 127.0.0.1 --port 8100 --reload",
    "build": "vite build --config frontend/vite.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "genai",
    "rag",
    "langchain",
    "chromadb",
    "mongodb",
    "interview-preparation",
    "express"
  ],
  "author": "PlacementPrep AI Team",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^0.3.40",
    "@langchain/openai": "^0.4.4",
    "chromadb": "^1.10.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "langchain": "^0.3.19",
    "mongoose": "^8.12.1",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "supertest": "^7.0.0",
    "vite": "^7.3.7",
    "vitest": "^3.0.7"
  }
}
