# ==========================================
# PlacementPrep AI - Environment Configuration
# ==========================================

# Application Port
PORT=3000
NODE_ENV=development

# MongoDB Connection
# Set to your local MongoDB URI or MongoDB Atlas cloud connection string
MONGODB_URI=mongodb://127.0.0.1:27017/placementprep
MONGODB_DATABASE=placementprep

# ChromaDB Vector Store
# URL of your running ChromaDB server instance
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION_NAME=placementprep_study_materials

# LLM Configuration (OpenAI, Groq, Ollama, OpenRouter, etc.)
# If left empty, PlacementPrep AI operates in high-fidelity offline development/mock mode
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional base URL for local LLMs (e.g. http://localhost:11434/v1 for Ollama)
LLM_BASE_URL=

# Embedding Model Configuration
# If left empty, falls back to deterministic local semantic feature embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Security & Upload Limits
SESSION_SECRET=
MAX_UPLOAD_SIZE=10485760
